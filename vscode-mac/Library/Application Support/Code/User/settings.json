{
    "vim.normalModeKeyBindingsNonRecursive": [
            {
            "before": ["<Tab>"],
            "commands": [
                "workbench.action.nextEditor"
            ]
        },
        {
            "before": ["<S-Tab>"],
            "commands": [
                "workbench.action.previousEditor"
            ]
        },
        {
            "before": ["<space>", "b", "d"],
            "commands": [
                "workbench.action.closeActiveEditor"
            ]
        },
        {
            "before": [
                "<space>",
                "c",
                "c"
            ],
            "commands": [
                "workbench.action.chat.open"
            ]
        },
        {
            "before": [
                "<space>",
                "c",
                "e"
            ],
            "commands": [
                "copyErrorAtCursor"
            ]
        },
        {
            "before": [
                "<space>",
                "e"
            ],
            "commands": [
                "workbench.files.action.focusFilesExplorer"
            ]
        },
        {
            "before": [
                "<space>",
                "f",
                "f"
            ],
            "commands": [
                "workbench.action.quickOpen"
            ]
        },
        {
            "before": [":"],
            "after": [":"],
            "commands": [
                "settings.cycle.statusBarShow"
            ]
        },
        {
            "before": [
                "<space>",
                "/"
            ],
            "commands": [
                "workbench.action.findInFiles"
            ]
        },
        {
            "before": [
                ":",
                "J",
                "<CR>"
            ],
            "commands": [
                {
                    "command": "workbench.action.terminal.sendSequence",
                    "args": {
                        "text": "\u001b[A\u000d"
                    }
                },
                "workbench.action.focusActiveEditorGroup"
            ]
        }
    ],
    "vim.commandLineModeKeyBindingsNonRecursive": [
        {
            "before": ["<CR>"],
            "after": ["<CR>"],
            "commands": ["settings.cycle.statusBarHide"]
        },
        {
            "before": ["<Esc>"],
            "after": ["<Esc>"],
            "commands": ["settings.cycle.statusBarHide"]
        },
        {
            "before": ["<C-c>"],
            "after": ["<C-c>"],
            "commands": ["settings.cycle.statusBarHide"]
        }
    ],
    "vim.visualModeKeyBindingsNonRecursive": [
        {
            "before": [
                "<space>",
                "c",
                "c"
            ],
            "commands": [
                "workbench.action.chat.open"
            ]
        },
        {
            "before": [
                "<space>",
                "c",
                "e"
            ],
            "commands": [
                "copyErrorAtCursor"
            ]
        },
        {
            "before": [
                "<space>",
                "/"
            ],
            "commands": [
                "workbench.action.findInFiles"
            ]
        }
    ],
    "vim.insertModeKeyBindings": [
        {
            "before": [
                "j",
                "k"
            ],
            "after": [
                "<Esc>"
            ]
        }
    ],
    "[python]": {
        "editor.formatOnType": true
    },
    "jupyter.interactiveWindow.creationMode": "perFile",
    "workbench.colorCustomizations": {
        "editorCursor.foreground": "#F4B400"
    },
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": [
                    "storage.type.function.vim",
                    "meta.function-call.vim",
                    "entity.name.function.vim"
                ],
                "settings": {
                    "foreground": "#ffff00"
                }
            }
        ]
    },
    "editor.accessibilitySupport": "off",
    "workbench.colorTheme": "Gruvbox Dark Medium",
    "vim.useCtrlKeys": false,
    "vim.handleKeys": {
        "<C-o>": true,
        "<C-i>": true
    },
    "editor.minimap.enabled": false,
    "editor.lineNumbers": "relative",
    "azure.resourceFilter": [
        "3aa4a235-b6e2-48d5-9195-7fcf05b459b0/7be5c910-a81e-472d-9070-6aaf07b753cc"
    ],
    "tabnine.experimentalAutoImports": true,
    "breadcrumbs.enabled": false,
    "github.copilot.nextEditSuggestions.enabled": true,
    "git.openRepositoryInParentFolders": "never",
    "update.showReleaseNotes": false,
    "chat.tools.terminal.autoApprove": {
        "cargo test": true,
        "cargo build": true,
        "cargo check": true,
        "mypy": true,
        "cargo leptos": true,
        "/^make test-integration$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^uv run pytest src/tests/integration$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^uv run pytest src/tests/unit$/": {
            "approve": true,
            "matchCommandLine": true
        }
    },
    "chat.agent.maxRequests": 50,
    "chat.viewSessions.orientation": "stacked",
    "window.commandCenter": false,
    "workbench.layoutControl.enabled": false,
    "vim.useSystemClipboard": true,
    "workbench.activityBar.location": "bottom",
    "terminal.integrated.profiles.osx": {
        "fish-tmux": {
            "path": "fish",
            "args": [
                "-c",
                "tmux new-session -A -s vscode"
            ]
        }
    },
    "terminal.integrated.defaultProfile.osx": "fish-tmux",
    "settings.cycle": [
        {
            "id": "statusBarShow",
            "overrideWorkspaceSettings": false,
            "values": [
                { "workbench.statusBar.visible": true }
            ]
        },
        {
            "id": "statusBarHide",
            "overrideWorkspaceSettings": false,
            "values": [
                { "workbench.statusBar.visible": false }
            ]
        }
    ],
    "workbench.statusBar.visible": true
}
