// Place your key bindings in this file to override the defaultsauto[]
[
  {
    "key": "cmd+s",
    "command": "-workbench.action.files.save"
  },
  {
    "key": "cmd+s",
    "command": "editor.action.inlineSuggest.trigger",
    "when": "editorTextFocus"
  },
  {
    "key": "cmd+shift+s",
    "command": "-workbench.action.files.saveAs"
  },
  {
    "key": "cmd+shift+s",
    "command": "github.copilot.chat.completions.toggle"
  },
  {
    "key": "cmd+shift+a",
    "command": "workbench.action.chat.toggle"
  } ,
    {
        "key": "e",
        "command": "workbench.action.toggleSidebarVisibility",
        "when": "sideBarFocus && !inputFocus"
    },
    {

        "key": "cmd+a",
        "command": "workbench.action.chat.open",
        "when": "editorTextFocus" 
    },
    {
        "key": "cmd+e",
        "command": "-actions.findWithSelection"
    },
    {
        "key": "cmd+e",
        "command": "-editor.actions.findWithSelection"
    },
    {
        "key": "cmd+e",
        "command": "-editor.action.nextMatchFindAction"
    },
    {
        "key": "cmd+e",
        "command": "-workbench.action.findInFiles"
    },
    {
        "key": "cmd+e",
        "command": "-actions.find"
    },
    {
        "key": "cmd+e",
        "command": "-workbench.action.quickOpen"
    },
    {
    "key": "cmd+e",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "!editorFocus && !searchViewletFocus"
    },
    {
        "key": "cmd+n",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "terminalFocus"
    },
    {
        "key": "shift+j",
        "command": "selectNextSuggestion",
        "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus"
    },
    {
        "key": "ctrl+down",
        "command": "-selectNextSuggestion",
        "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus"
    },
    {
        "key": "shift+k",
        "command": "selectPrevSuggestion",
        "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus"
    },
    {
        "key": "ctrl+up",
        "command": "-selectPrevSuggestion",
        "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus"
    },
    {
        "key": "cmd+n",
        "command": "workbench.action.terminal.focus",
        "when": "editorTextFocus"
    },
    {
        "key": "cmd+j",
        "command": "workbench.action.togglePanel",
        "when": "panelFocus"
    },
    {
        "key": "ctrl+shift+j",
        "command": "workbench.action.togglePanel"
    },
    {
        "key": "ctrl+j",
        "command": "-workbench.action.togglePanel"
    },
    {
        "key": "ctrl+j",
        "command": "editor.action.inlineSuggest.commit",
        "when": "inlineSuggestionVisible"
    },
    {
        "key": "ctrl+shift+alt+cmd+t",
        "command": "commandId",
    },
    {
        "key": "cmd+n",
        "command": "-workbench.action.files.newUntitledFile"
    },
    {
        "key": "ctrl+k",
        "command": "github.copilot.acceptCursorPanelSolution",
        "when": "github.copilot.activated && github.copilot.panelVisible && activeWebviewPanelId == 'GitHub Copilot Suggestions'"
    },
    {
        "key": "ctrl+shift+7",
        "command": "-github.copilot.acceptCursorPanelSolution",
        "when": "github.copilot.activated && github.copilot.panelVisible && activeWebviewPanelId == 'GitHub Copilot Suggestions'"
    },
    {
        "key": "enter",
        "command": "list.select",
        "when": "listFocus && !inputFocus"
    },
    {
        "key": "enter",
        "command": "-renameFile",
        "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
    },
    {
        "key": "a",
        "command": "explorer.newFile",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "shift+a",
        "command": "explorer.newFolder",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "ctrl+space",
        "command": "-editor.action.triggerSuggest",
        "when": "terminalFocus"
    },
    {
        "key": "cmd+shift+b",
        "command": "workbench.action.toggleStatusbarVisibility"
    }
]
